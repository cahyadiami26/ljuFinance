# =====================================================================
# LJU Finance & Accounting System — konfigurasi Apache
# =====================================================================
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Jika aplikasi dipasang di sub-folder, sesuaikan RewriteBase berikut.
    # RewriteBase /

    # Pretty URL (opsional). Aktifkan 'pretty_url' => true pada config/config.php.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Blokir akses langsung ke file sensitif
<FilesMatch "\.(sql|md|log|ini|sh|yml|yaml|json|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Header keamanan dasar
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Jangan cache halaman dinamis
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
</IfModule>
